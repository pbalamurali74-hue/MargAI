# Leave empty for the existing same-origin deployment or local Vite proxies.
# For a separately hosted interface, use your real deployed Google Cloud service origin.
VITE_API_ORIGIN=
# Optional Python vision/phone telemetry service origin; includes its existing /api routes.
VITE_VISION_API_ORIGIN=
# Google Maps JavaScript API browser key. Restrict it to your website origins.
VITE_GOOGLE_MAPS_API_KEY=

# Deployed updated phone app used by the car-display QR (static frontend only).
VITE_PHONE_APP_ORIGIN=
